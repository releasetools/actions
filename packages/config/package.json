{
  "name": "@releasetools/config",
  "version": "0.3.0",
  "description": "Reads .releasetools.yaml and writes starter configuration with config adopt.",
  "license": "Apache-2.0",
  "main": "./releasetools-config.js",
  "exports": {
    ".": {
      "types": "./releasetools-config.d.ts",
      "default": "./releasetools-config.js"
    }
  },
  "files": [
    "releasetools-config.js",
    "releasetools-config.d.ts",
    "CHANGELOG.md",
    "cli.js",
    "version.js",
    "version.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releasetools/actions.git",
    "directory": "packages/config"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "config": "./cli.js"
  }
}
